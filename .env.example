# Copie para .env.local no seu computador, ou cadastre na Vercel em
# Settings > Environment Variables. Nunca coloque valores reais neste arquivo.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Acesso total ao banco. Usada só no servidor, a partir da etapa 2.
SUPABASE_SERVICE_ROLE_KEY=

# Motores de IA (a partir da etapa 2)
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
