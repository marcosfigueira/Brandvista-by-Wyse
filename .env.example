# Copie para .env.local no seu computador, ou cadastre na Vercel em
# Settings > Environment Variables. Nunca coloque valores reais neste arquivo.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Acesso total ao banco. Usada só no servidor, pela fila das rodadas completas.
SUPABASE_SERVICE_ROLE_KEY=

# Motores de IA (a partir da etapa 2)
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Fila das rodadas completas. Criadas pela integração do Inngest com a Vercel.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
